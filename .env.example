# Toolforge / enwiki replica credentials
# Copy to .env and fill in. Never commit .env.

# Your Toolforge shell/LDAP username (for opening the SSH tunnel)
TOOLFORGE_USER="your-toolforge-username"

# Replica database username (starts with "u", e.g. u12345)
# From https://toolsadmin.wikimedia.org/ → Tools → your tool → database credentials
# Or ~/.my.cnf on Toolforge after `sql enwiki`
TOOLFORGE_SQL_USER="u12345"

# Replica database password
TOOLFORGE_SQL_PASSWORD="your-password-here"

# Local port for the SSH tunnel (default 3307)
# TOOLFORGE_DB_PORT="3307"

# Wikimedia API User-Agent (required for polite API use; keep out of git)
# Include a wiki username and/or email so WMF can contact you.
WIKIMEDIA_USER_AGENT="ReferenceNeedPrototype/0.1 (User:YourName, you@example.com) research-prototype"
